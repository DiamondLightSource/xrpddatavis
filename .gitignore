# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]


# OS files
*.DS_Store

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
**/_version.py

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
cov.xml
.pytest_cache/
.mypy_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/
docs/_api

# PyBuilder
target/

# likely venv names
.venv*
venv*

# further build artifacts
lockfiles/

# ruff cache
.ruff_cache/

# frontend (frontend/readme.md) - node_modules, tsc's incremental build
# cache, and the built output. Nothing under src/xrddatavis/static is
# tracked: it's all generated by `npm run build` (see frontend/vite.config.ts),
# and is built fresh by the Dockerfile and by CI when packaging - never
# committed, the same way a Python sdist doesn't commit compiled bytecode.
frontend/node_modules/
frontend/*.tsbuildinfo
/src/xrddatavis/static/
